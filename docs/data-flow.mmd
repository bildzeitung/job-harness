flowchart TD
    RESUME(["Resume YAML"])
    DISQ(["Disqualifiers YAML"])

    subgraph BOARDS ["External Sources"]
        direction LR
        B1["LinkedIn · Indeed · Adzuna"]
        B2["ZipRecruiter · Greenhouse · Lever · Web"]
    end

    subgraph SEEK ["Stage 1 — Seek    (job-seeker)"]
        S["Search all sources in parallel<br>Deduplicate · insert new postings"]
    end

    DB[("postings.db")]

    subgraph SCORE ["Stage 2 — Score    (job-preparer)"]
        F["Pre-filter: hard disqualifiers → skip"]
        SC["5-dimension fit score  1–100<br>Age + competition modifiers"]
        F --> SC
    end

    SEL{{"Stage 3 — Select<br>You choose from top-ranked postings"}}

    subgraph PREP ["Stage 4 — Prepare    (per job)"]
        direction LR
        T["resume-tailor<br>ATS-targeted CV"]
        C["cover-letter-creator<br>Personalised to role + company"]
    end

    subgraph OUT ["Output    (job-data/output/YYYY-MM-DD/)"]
        direction LR
        RP["Resume PDF"]
        CL["Cover Letter PDF"]
        FR["final-report.md"]
    end

    BOARDS  --> S
    RESUME  -->|"search guidance"| S
    S       -->|"INSERT new postings"| DB
    DB      -->|"unscored postings"| F
    DISQ    -->|"keyword blocklist"| F
    RESUME  -->|"fit scoring context"| SC
    DISQ    -->|"score modifiers"| SC
    SC      --> SEL
    SEL     --> T & C
    RESUME  -->|"base document"| T
    RESUME  -->|"voice + experience"| C
    T       --> RP
    C       --> CL
    PREP    -->|"rank · URLs · status"| FR

    classDef resumeNode fill:#f4a261,stroke:#e76f51,color:#000
    classDef disqNode   fill:#457b9d,stroke:#1d3557,color:#fff
    class RESUME resumeNode
    class DISQ   disqNode
