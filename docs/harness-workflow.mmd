flowchart TD

    %% ─── Entry Points ────────────────────────────────────────────────────────
    JS(["/job-search"])
    JSE(["/job-search-email"])

    %% ─── STAGE 1: SEEK ───────────────────────────────────────────────────────
    subgraph SEEK ["STAGE 1 — SEEK"]
        SEEKER["job-seeker  ·  Sonnet  ·  orchestrator<br>① Generate candidate-summary.json  (cached per day)<br>② Init SQLite schema  (postings + companies tables)<br>③ MCP connectivity probe  (LinkedIn · Gmail · Indeed · ZipRecruiter)"]

        SUB_LI["job-seeker-linkedin<br>LinkedIn MCP"]
        SUB_EM["job-seeker-email<br>Gmail MCP"]
        SUB_IND["job-seeker-indeed<br>Indeed MCP"]
        SUB_ZIP["job-seeker-ziprecruiter<br>ZipRecruiter MCP"]
        SUB_ADZ["job-seeker-adzuna<br>Adzuna Canada REST API"]
        SUB_GH["job-seeker-greenhouse<br>Greenhouse · Lever public APIs"]
        SUB_RES["job-seeker-research<br>Wellfound · Ashby · funded startups<br>→ UPSERT companies (notes · remote/Canada confirmed)"]

        S_DONE["Merge results  ·  deduplicate against existing DB URLs<br>Audit log → jobs/search-YYYY-MM-DD.json<br>INSERT OR IGNORE into DB  (status = 'new')"]

        SEEKER -->|"conditional on probe"| SUB_LI & SUB_EM & SUB_IND & SUB_ZIP
        SEEKER -->|"always · parallel"| SUB_ADZ & SUB_GH & SUB_RES
        SUB_LI & SUB_EM & SUB_IND & SUB_ZIP & SUB_ADZ & SUB_GH & SUB_RES --> S_DONE
    end

    %% ─── Email-only path (bypasses SEEK orchestrator) ────────────────────────
    EMAIL_ONLY["job-seeker-email  (standalone)<br>Reads most-recent LinkedIn job-alert from Gmail<br>Extracts postings · labels thread 'AI'<br>INSERT OR IGNORE into DB  (status = 'new')"]

    %% ─── Persistent store ────────────────────────────────────────────────────
    DB[("SQLite DB<br>postings · companies")]

    %% ─── STAGE 2: SCORE ──────────────────────────────────────────────────────
    subgraph SCORE ["STAGE 2 — SCORE  (job-preparer · Sonnet)"]
        SC1["Query DB<br>WHERE status = 'new'  OR  (status = 'scored' AND scored_date < 7 days ago)"]
        SC2["Pre-filter<br>Hard disqualifiers → UPDATE status = 'skipped'<br>(US-only · on-site only · intern · entry-level · relocation required)"]
        SC3["Write scoring-batch-N.json  (≤ 20 postings per file)<br>Delete stale batch files first"]
        SC4["scoring_module  (Python · Claude API · threaded · prompt-cached)<br><br>Per posting:<br>  · WebFetch full JD text  (skipped if jd_text already in DB)<br>  · Score 5 dimensions  →  weighted base score  (× 10 = 1–100)<br>      tech fit 35%  ·  seniority match 25%  ·  domain fit 20%<br>      remote/Canada confirmed 10%  ·  role clarity 10%<br>  · Disqualifier modifiers:<br>      requires named certification −40  ·  US-only −25  ·  relocation required −30<br>  · Freshness modifiers:  ≤3 days +8  ·  4–7 days +4  ·  15–30 days −5  ·  >30 days −12<br>  · Applicant modifiers:  <25 +5  ·  101–200 −5  ·  >200 −10<br>  · final_score = clamp(base_score + modifier, 1, 100)<br>  · UPDATE postings: scores · job_description_text · status = 'scored'<br>  · UPSERT companies: last_seen_date · remote/canada flags  (MAX — never downgrade)"]
        SC1 --> SC2 --> SC3 --> SC4
    end

    %% ─── STAGE 3: SELECT ─────────────────────────────────────────────────────
    subgraph SELECT ["STAGE 3 — SELECT  (job-preparer)"]
        SEL1["Query DB<br>WHERE status = 'scored'  ORDER BY final_score DESC"]
        SEL2["Take top 5  where  final_score ≥ 75<br>(if fewer than 5 pass, take all that do)"]
        SEL3["UPDATE DB:  status = 'selected',  selected_date = today"]
        SEL1 --> SEL2 --> SEL3
    end

    %% ─── STAGE 4: PREPARE ────────────────────────────────────────────────────
    subgraph PREPARE ["STAGE 4 — PREPARE  (job-preparer orchestrates  ·  job-pipeline-worker × N)"]
        PR1["TeamCreate:  job-prep-YYYY-MM-DD<br>Query companies WHERE name IN (selected companies)<br>TaskCreate × N per job<br>(url · company · title · output_dir · score · job_description_text · company_notes)"]
        PR2["Spawn job-pipeline-worker × N  (Sonnet · all in parallel · max 5)"]

        subgraph WLOOP ["Per Worker — work loop  (repeats until no unclaimed tasks remain)"]
            W1["Claim task  →  TaskUpdate: status = in_progress"]
            W2["Spawn resume-tailor  (Opus)<br>→ ATS-targeted CV YAML<br>→ output_dir/{Name}_{Company}_Resume.yaml"]
            W3["rendercv render<br>→ output_dir/{Name}_{Company}_Resume.pdf"]
            W4["Spawn cover-letter-creator  (Opus)<br>→ Cover Letter MD<br>→ output_dir/{Company}_Cover_Letter_CV.yaml  (rendercv-wrapped)"]
            W5["rendercv render<br>→ output_dir/{Company}_Cover_Letter.pdf"]
            W6["TaskUpdate: completed<br>DB UPDATE: status = 'applied'<br>SendMessage → lead  (output paths + status)"]
            WC{{"More<br>unclaimed<br>tasks?"}}
            WIDLE["Send lead:  idle — no tasks remaining"]

            W1 --> W2 --> W3 --> W4 --> W5 --> W6 --> WC
            WC -->|"yes"| W1
            WC -->|"no"| WIDLE
        end

        PR1 --> PR2 --> W1
        WIDLE --> PDONE["job-preparer: all workers idle<br>SendMessage shutdown → each worker<br>TeamDelete<br>Write final-report.md"]
    end

    %% ─── Output ──────────────────────────────────────────────────────────────
    OUT["OUTPUT  ·  job-data/output/YYYY-MM-DD/<br>  final-report.md  (rank · company · title · score · URL · status)<br>  {Company}/<br>    {Name}_{Company}_Resume.pdf<br>    {Company}_Cover_Letter.pdf<br>    {Company}_Cover_Letter.md"]

    %% ─── Top-level flow: skills spawn orchestrators ──────────────────────────
    JS  -->|"1 · spawn"| SEEKER
    JS  -->|"2 · spawn  (after Seek)"| SC1
    JSE -->|"1 · spawn"| EMAIL_ONLY
    JSE -->|"2 · spawn  (after email-seek)"| SC1

    %% ─── DB read/write connections ───────────────────────────────────────────
    S_DONE     -.->|"INSERT  status='new'"| DB
    EMAIL_ONLY -.->|"INSERT  status='new'"| DB
    SUB_RES    -.->|"UPSERT companies"| DB
    DB         -.->|"read postings"| SC1
    DB         -.->|"read companies"| PR1
    SC4        -.->|"UPDATE status='scored' · UPSERT companies"| DB
    SEL3       -.->|"UPDATE  status='selected'"| DB
    W6         -.->|"UPDATE  status='applied'"| DB

    %% ─── Stage-to-stage flow ─────────────────────────────────────────────────
    SC4   --> SEL1
    SEL3  --> PR1
    PDONE --> OUT
