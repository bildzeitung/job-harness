flowchart TD

    %% ─── Entry Points ────────────────────────────────────────────────────────
    JS(["/job-search"])

    %% ─── STAGE 1: SEEK ───────────────────────────────────────────────────────
    subgraph SEEK ["STAGE 1 — SEEK"]
        SEEKER["job-seeker  ·  Sonnet  ·  orchestrator<br>① Read jobs/sources-config.json  (which sources are enabled)<br>② Generate candidate-summary.json  (cached per day; from resume + target-roles.md)<br>③ Init SQLite schema  (postings + companies tables)<br>④ Seed config if missing  (disqualifiers.yaml · target-roles.md)<br>⑤ MCP connectivity probe  (LinkedIn · Indeed · ZipRecruiter)"]

        SUB_LI["job-seeker-linkedin<br>LinkedIn MCP"]
        SUB_IND["job-seeker-indeed<br>Indeed MCP"]
        SUB_ZIP["job-seeker-ziprecruiter<br>ZipRecruiter MCP"]
        SUB_ADZ["job-seeker-adzuna<br>Adzuna Canada REST API"]
        SUB_GH["job-seeker-greenhouse<br>Greenhouse · Lever · Ashby · Workable · Recruitee public ATS APIs"]
        SUB_REM["job-seeker-remotive<br>Remotive · Himalayas · We Work Remotely<br>remote-jobs boards (Canada-eligible)"]
        SUB_RES["job-seeker-research<br>Wellfound · funded startups · niche boards<br>Canada boards (Job Bank · TrueUp · NoDesk)<br>→ UPSERT companies (notes · remote/Canada confirmed)"]

        S_DONE["consolidate_module  (Python)<br>Merge per-platform temp files  ·  deduplicate against existing DB URLs<br>Audit log → jobs/search-YYYY-MM-DD.json<br>INSERT OR IGNORE postings (status = 'new')<br>Create companies row + company_postings link  (ON CONFLICT DO NOTHING)"]

        SEEKER -->|"conditional on probe"| SUB_LI & SUB_IND & SUB_ZIP
        SEEKER -->|"always · parallel"| SUB_ADZ & SUB_GH & SUB_REM & SUB_RES
        SUB_LI & SUB_IND & SUB_ZIP & SUB_ADZ & SUB_GH & SUB_REM & SUB_RES --> S_DONE
    end

    %% ─── Persistent store ────────────────────────────────────────────────────
    DB[("SQLite DB<br>postings · companies")]

    %% ─── STAGE 2: SCORE ──────────────────────────────────────────────────────
    subgraph SCORE ["STAGE 2 — SCORE  (job-preparer · Sonnet)"]
        SC1["Query DB<br>WHERE status = 'new'  OR  (status = 'scored' AND scored_date < 7 days ago)"]
        SC2["Pre-filter<br>Hard disqualifiers → UPDATE status = 'skipped'<br>(US-only · on-site only · intern · entry-level · relocation required)"]
        SC3["Write scoring-batch-N.json  (≤ 20 postings per file)<br>Delete stale batch files first"]
        SC4["scoring_module  (Python · Claude Haiku 4.5 · threaded · prompt-cached)<br><br>Per posting:<br>  · Fetch full JD text  (skipped if jd_text already in DB)<br>  · Score 5 dimensions  →  weighted base score  (× 10 = 1–100)<br>      tech fit 35%  ·  seniority match 25%  ·  domain fit 20%<br>      remote/Canada confirmed 10%  ·  role clarity 10%<br>  · Disqualifier modifiers  (from disqualifiers.yaml scoring_modifiers):<br>      named certification −40  ·  on-site/relocation −30  ·  excludes Canada −25<br>  · Freshness modifiers:  ≤3 days +8  ·  4–7 days +4  ·  15–30 days −5  ·  >30 days −12<br>  · Applicant modifiers:  <25 +5  ·  101–200 −5  ·  >200 −10<br>  · Fetch-failed (scored from summary) −5<br>  · final_score = clamp(base_score + modifier, 1, 100)<br>  · UPDATE postings only: scores · job_description_text · status = 'scored'<br>    (does NOT write the companies table)"]
        SC1 --> SC2 --> SC3 --> SC4
    end

    %% ─── STAGE 3: SELECT ─────────────────────────────────────────────────────
    subgraph SELECT ["STAGE 3 — SELECT  (job-preparer phase:score → user → phase:prepare)"]
        SEL1["phase:score — harness-db report --json --min-score 75 --top $JOB_TOP_N<br>Rank scored postings  (score desc, then fewest applicants)<br>Return ranked top-N (JOB_TOP_N, default 5) to the job-search skill  ·  job-preparer stops"]
        SEL2{{"USER picks which jobs to prepare<br>(job-search skill prompts in plain text)"}}
        SEL3["phase:prepare — for the chosen URLs:<br>UPDATE DB:  status = 'selected',  selected_date = today"]
        SEL1 --> SEL2 --> SEL3
    end

    %% ─── STAGE 4: PREPARE ────────────────────────────────────────────────────
    subgraph PREPARE ["STAGE 4 — PREPARE  (job-preparer orchestrates  ·  job-pipeline-worker × N)"]
        PR1["TeamCreate:  job-prep-YYYY-MM-DD<br>Query companies WHERE name IN (selected companies)<br>TaskCreate × N per job  (resume-only: generate_cover_letter = false)<br>(url · company · title · output_dir · score · job_description_text · company_notes)"]
        PR2["Spawn job-pipeline-worker × N  (Sonnet · all in parallel · max 5)"]

        subgraph WLOOP ["Per Worker — work loop  (repeats until no unclaimed tasks remain)"]
            W1["Claim task  →  TaskUpdate: status = in_progress"]
            W2["Spawn resume-tailor  (Opus)<br>→ ATS-targeted CV YAML<br>→ output_dir/{Name}_{Company}_Resume.yaml"]
            W3["rendercv render<br>→ output_dir/{Name}_{Company}_Resume.pdf"]
            W4["Cover letter — ONLY if generate_cover_letter = true  (off by default)<br>Spawn cover-letter-creator  (Opus)<br>→ Cover Letter MD<br>→ output_dir/{Company}_Cover_Letter_CV.yaml  (rendercv-wrapped)"]
            W5["rendercv render  (cover-letter pass only)<br>→ output_dir/{Company}_Cover_Letter.pdf"]
            W6["TaskUpdate: completed<br>DB UPDATE: status = 'prepared'<br>SendMessage → lead  (output paths + status)"]
            WC{{"More<br>unclaimed<br>tasks?"}}
            WIDLE["Send lead:  idle — no tasks remaining"]

            W1 --> W2 --> W3
            W3 -->|"default · resume only"| W6
            W3 -.->|"if cover letters opted in"| W4 --> W5 --> W6
            W6 --> WC
            WC -->|"yes"| W1
            WC -->|"no"| WIDLE
        end

        PR1 --> PR2 --> W1
        WIDLE --> PDONE["job-preparer: all workers idle<br>SendMessage shutdown → each worker<br>TeamDelete<br>Write final-report.md (resumes; cover letters 'not generated')<br>Return prepared_jobs handoff to job-search skill · stop"]
        PDONE --> PCL{{"USER opts in to cover letters?<br>(job-search skill prompts · OFF by default)"}}
        PCL -.->|"yes → phase:cover-letters"| PCL2["job-preparer re-runs the team for cover letters only<br>(generate_cover_letter = true · resume reused)<br>Update final-report.md with cover-letter PDFs"]
    end

    %% ─── Output ──────────────────────────────────────────────────────────────
    OUT["OUTPUT  ·  job-data/output/YYYY-MM-DD/<br>  final-report.md  (rank · company · title · score · URL · status)<br>  {Company}/<br>    {Name}_{Company}_Resume.pdf<br>    {Company}_Cover_Letter.pdf  (only if opted in)<br>    {Company}_Cover_Letter.md  (only if opted in)"]

    %% ─── Top-level flow: skills spawn orchestrators ──────────────────────────
    JS  -->|"1 · spawn"| SEEKER
    JS  -->|"2 · spawn  (after Seek)"| SC1

    %% ─── DB read/write connections ───────────────────────────────────────────
    S_DONE     -.->|"INSERT  status='new'"| DB
    SUB_RES    -.->|"UPSERT companies"| DB
    SUB_ADZ    -.->|"UPSERT companies (canada_confirmed)"| DB
    DB         -.->|"read postings"| SC1
    DB         -.->|"read scored postings"| SEL1
    DB         -.->|"read companies"| PR1
    SC4        -.->|"UPDATE  status='scored'  (postings only)"| DB
    SEL3       -.->|"UPDATE  status='selected'"| DB
    W6         -.->|"UPDATE  status='prepared'"| DB

    %% ─── Stage-to-stage flow ─────────────────────────────────────────────────
    SC4   --> SEL1
    SEL3  --> PR1
    PDONE --> OUT
