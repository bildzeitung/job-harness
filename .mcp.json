{
  "mcpServers": {
    "linkedin": {
      "command": "wsl.exe",
      "args": [
	"docker",
        "run", "--rm", "-i",
	"-v", "~/.linkedin-mcp:/home/pwuser/.linkedin-mcp",
        "stickerdaniel/linkedin-mcp-server:latest"
      ]
    },
    "sqlite": {
      "command": "wsl.exe",
      "args": [
	"docker",
        "run", "--rm", "-i",
        "-v", "/home/dmklein/mcp-sqlite:/mcp",
        "mcp/sqlite",
        "--db-path",
        "/mcp/job-search.db"
      ]
    }
  }
}

