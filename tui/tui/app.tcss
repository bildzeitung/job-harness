Screen {
    layout: vertical;
}

#logo-banner {
    height: 3;
    padding: 0 1;
    color: $accent;
    background: $surface;
}

TabbedContent {
    height: 1fr;
}

TabPane {
    height: 1fr;
    padding: 0;
}

#jobs-panel {
    height: 1fr;
}

#jobs-pane {
    height: 1fr;
    layout: vertical;
}

#jobs-table {
    height: 1fr;
}

#company-panel {
    height: 1fr;
}

#companies-pane {
    height: 1fr;
    layout: vertical;
}

#companies-table {
    height: 1fr;
}

#company-details-panel {
    height: 14;
    border-top: solid $primary;
    background: $surface;
    padding: 0 1;
}

#company-details-content {
    color: $text;
    padding: 0;
}

#details-panel {
    height: 14;
    border-top: solid $primary;
    background: $surface;
    padding: 0 1;
}

#details-content {
    color: $text;
    padding: 0;
}

#output-panel {
    height: 20;
    border-top: solid $warning;
    background: $panel;
    padding: 0 1;
}

#settings-panel {
    height: 1fr;
}

.settings-row {
    height: auto;
    padding: 1 0;
}

.settings-row Input {
    width: 30;
}

.settings-row Button {
    margin: 0 1;
}

/* Let the field list grow to its content so the VerticalScroll above it can
   actually scroll; otherwise the default 1fr height clips the last rows. */
#config-fields {
    height: auto;
}

.config-row {
    height: auto;
}

.config-row .config-label {
    width: 28;
    height: 3;
    content-align: left middle;
    padding-right: 1;
}

.config-row Input {
    width: 1fr;
}

.locale-label {
    padding: 1 1 0 0;
}

#locale-select {
    width: 30;
}
