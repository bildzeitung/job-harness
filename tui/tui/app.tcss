Screen {
    layout: vertical;
}

TabbedContent {
    height: 1fr;
}

TabPane {
    height: 1fr;
    padding: 0;
}

#jobs-pane {
    height: 1fr;
    layout: vertical;
}

#jobs-table {
    height: 1fr;
}

#companies-table {
    height: 1fr;
}

#details-panel {
    height: 14;
    border-top: solid $primary;
    background: $surface;
    padding: 0 1;
}

#details-content {
    color: $text;
    padding: 0;
}

#output-panel {
    height: 20;
    border-top: solid $warning;
    background: $panel;
    padding: 0 1;
}
