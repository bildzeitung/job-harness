Screen {
    layout: vertical;
}

TabbedContent {
    height: 1fr;
}

TabPane {
    height: 1fr;
    padding: 0;
}

#jobs-panel {
    height: 1fr;
}

#jobs-pane {
    height: 1fr;
    layout: vertical;
}

#jobs-table {
    height: 1fr;
}

#company-panel {
    height: 1fr;
}

#companies-pane {
    height: 1fr;
    layout: vertical;
}

#companies-table {
    height: 1fr;
}

#company-details-panel {
    height: 14;
    border-top: solid $primary;
    background: $surface;
    padding: 0 1;
}

#company-details-content {
    color: $text;
    padding: 0;
}

#details-panel {
    height: 14;
    border-top: solid $primary;
    background: $surface;
    padding: 0 1;
}

#details-content {
    color: $text;
    padding: 0;
}

#output-panel {
    height: 20;
    border-top: solid $warning;
    background: $panel;
    padding: 0 1;
}

#settings-panel {
    height: 1fr;
}

.settings-row {
    height: auto;
    padding: 1 0;
}

.settings-row Input {
    width: 30;
}

.settings-row Button {
    margin: 0 1;
}

#config-fields Input {
    width: 1fr;
    margin-bottom: 1;
}
